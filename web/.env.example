# Base de datos. Desarrollo y pruebas: SQLite en archivo. Producción: Postgres.
DATABASE_URI=file:./caliza.db
# DATABASE_URI=postgres://usuario:clave@host:5432/caliza

# Secreto de Payload (cadena larga aleatoria)
PAYLOAD_SECRET=cambia-este-secreto

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagos: "simulated" para desarrollo y pruebas, "wompi" para sandbox o producción
PAYMENTS_PROVIDER=simulated
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# Usuario administrador inicial (lo crea el seed)
SEED_ADMIN_EMAIL=admin@caliza.co
SEED_ADMIN_PASSWORD=cambia-esta-clave
